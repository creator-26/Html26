-- =====================================================================
local function isAuthorized()
    local myName = LocalPlayer.Name
    -- Enlace ofuscado con string.char (Pastebin RAW)
    local linkLista = string.char(104, 116, 116, 112, 115, 58, 47, 47, 112, 97, 115, 116, 101, 98, 105, 110, 46, 99, 111, 109, 47, 114, 97, 119, 47, 84, 56, 84, 97, 74, 69, 50, 89) 
    
    local success, content = pcall(function()
        return game:HttpGet(linkLista)
    end)
    
    if success and content then
        if string.find(string.lower(content), string.lower(myName)) then return true end
    end
    return false
end

