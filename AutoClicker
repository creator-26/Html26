labelAjuste.Font = Enum.Font.Gotham
labelAjuste.TextXAlignment = Enum.TextXAlignment.Left
labelAjuste.Parent = MainFrame

local inputAjusteX = Instance.new("TextBox")
inputAjusteX.Size = UDim2.new(0, 90, 0, 30)
inputAjusteX.Position = UDim2.new(0, 15, 0, 281)
inputAjusteX.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
inputAjusteX.TextColor3 = Color3.fromRGB(255, 255, 255)
inputAjusteX.PlaceholderText = "X: 0"
