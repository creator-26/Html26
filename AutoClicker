-- Actualiza el texto de la caja seg煤n el valor guardado y la unidad activa
local function actualizarCajaTexto()
    if unidadSeleccionada == "ms" then
        inputVelocidad.Text = tostring(math.floor(velocidadClickSegundos * 1000 + 0.5))
    else
        inputVelocidad.Text = tostring(velocidadClickSegundos)
    end
end

-- Cambia entre segundos y milisegundos, convirtiendo el n煤mero mostrado
local function seleccionarUnidad(unidad)
    unidadSeleccionada = unidad
    btnS.BackgroundColor3 = (unidad == "s") and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(45, 45, 45)
    btnMS.BackgroundColor3 = (unidad == "ms") and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(45, 45, 45)
    actualizarCajaTexto()
end

btnS.MouseButton1Click:Connect(function()
    seleccionarUnidad("s")
end)

btnMS.MouseButton1Click:Connect(function()
    seleccionarUnidad("ms")
end)

-- ================== CALIBRACIÓN: AJUSTE X / AJUSTE Y ==================
-- Corrige el desfase entre dónde se ve el cuadro y dónde cae el click real.
-- Prueba positivo/negativo hasta que el click caiga justo en el centro.
local ajusteX = 36
local ajusteY = 54

local labelAjuste = Instance.new("TextLabel")
labelAjuste.Text = "Ajuste X  /  Ajuste Y:"
labelAjuste.Size = UDim2.new(0, 190, 0, 16)
