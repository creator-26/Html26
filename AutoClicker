b1.MouseButton1Click:Connect(function()
    if not ClickTarget then
        ClickTarget = Instance.new("Frame", ScreenGui)
        ClickTarget.Size = UDim2.new(0, 60, 0, 60)
        ClickTarget.Position = UDim2.new(0.5, -30, 0.5, -30)
        ClickTarget.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        ClickTarget.BackgroundTransparency = 0.5
        ClickTarget.Draggable = true
        ClickTarget.Active = true
        Instance.new("UICorner", ClickTarget)

        -- Borde bien visible, para que se note claramente dónde empieza y termina el cuadro
        local borde = Instance.new("UIStroke")
        borde.Color = Color3.fromRGB(0, 200, 140)
        borde.Thickness = 2
        borde.Parent = ClickTarget

        -- Punto central: marca exactamente el pixel donde va a caer el click
        local puntoCentral = Instance.new("Frame")
        puntoCentral.Size = UDim2.fromOffset(10, 10)
        puntoCentral.AnchorPoint = Vector2.new(0.5, 0.5)
        puntoCentral.Position = UDim2.fromScale(0.5, 0.5)
        puntoCentral.BackgroundColor3 = Color3.fromRGB(0, 200, 140)
        puntoCentral.BorderSizePixel = 0
        puntoCentral.Parent = ClickTarget
        Instance.new("UICorner", puntoCentral).CornerRadius = UDim.new(1, 0)
    end
end)

b2.MouseButton1Click:Connect(function()
    if ClickTarget and not IsAutoClicking then
        IsAutoClicking = true
        b2.Text = "Funcionando 💪"
        ClickTarget.Active = false -- deja de bloquear su propio click
        task.spawn(function()
            local VIM = game:GetService("VirtualInputManager")
            while IsAutoClicking do
                local posX = ClickTarget.AbsolutePosition.X + (ClickTarget.AbsoluteSize.X / 2) + ajusteX
                local posY = ClickTarget.AbsolutePosition.Y + (ClickTarget.AbsoluteSize.Y / 2) + ajusteY
                VIM:SendMouseButtonEvent(posX, posY, 0, true, game, 1)
                VIM:SendMouseButtonEvent(posX, posY, 0, false, game, 1)
                task.wait(velocidadClickSegundos)
            end
        end)
    end
end)

b3.MouseButton1Click:Connect(function()
