inputAjusteX.FocusLost:Connect(function()
    local valor = tonumber(inputAjusteX.Text)
    ajusteX = valor or 0
    inputAjusteX.Text = tostring(ajusteX)
end)

inputAjusteY.FocusLost:Connect(function()
    local valor = tonumber(inputAjusteY.Text)
    ajusteY = valor or 0
    inputAjusteY.Text = tostring(ajusteY)
end)

-- Cuando terminas de escribir el n煤mero (le das a "listo" o tocas afuera)
inputVelocidad.FocusLost:Connect(function()
    local valor = tonumber(inputVelocidad.Text)

    if not valor or valor <= 0 then
        -- número inválido: regresamos al último valor válido, sin romper nada
        actualizarCajaTexto()
        return
    end

    if unidadSeleccionada == "ms" then
        velocidadClickSegundos = valor / 1000
    else
        velocidadClickSegundos = valor
    end

    -- evita un valor tan bajo que sature el cliente
    if velocidadClickSegundos < 0.001 then
        velocidadClickSegundos = 0.001
    end

    actualizarCajaTexto()
end)

